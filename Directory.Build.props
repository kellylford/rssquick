<Project>

  <!--
    Keep bin/ and obj/ out of every project's default source globs.

    This has to live here rather than in a .csproj: the SDK computes its default Compile items in
    props imported at the TOP of an SDK-style project, so a DefaultItemExcludes set in the project
    body is evaluated too late to affect them. Directory.Build.props is imported before those props.

    Why it matters for a WPF project specifically: XAML is compiled through a generated temporary
    project (RSSReaderWPF_<hash>_wpftmp.csproj) with its OWN BaseIntermediateOutputPath, so the
    SDK's implicit "exclude my own obj" rule never covers the real obj/. Every generated .g.cs
    there is then picked up a second time by the default glob:

        error NETSDK1022: Duplicate 'Compile' items were included.

    Ordinary local and CI builds survive this; Dependabot's clean-clone design-time build does not,
    and dependency updates silently stop being proposed. Forward slashes are deliberate —
    Dependabot builds on Linux, where a bin\** pattern matches nothing.
  -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Audit transitive packages too (default is direct-only); vulnerable deps warn at restore. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- The nullable warnings that turn into runtime crashes, caught at build time instead. -->
    <WarningsAsErrors>CS8602;CS8604;CS8618</WarningsAsErrors>
  </PropertyGroup>

  <!-- Product identity, stamped into the executable and read by the installer script. -->
  <PropertyGroup>
    <Product>RSS Quick</Product>
    <Company>Kelly Ford</Company>
    <Authors>Kelly Ford</Authors>
    <Copyright>Copyright © Kelly Ford</Copyright>
    <!-- VERSION is the single source of truth: prepare-release.ps1 writes it, the installer
         script reads it, and it lands in the executable's file version from here. -->
    <_VersionFromFile>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION'))</_VersionFromFile>
    <VersionPrefix>$(_VersionFromFile.Trim())</VersionPrefix>
    <RepositoryUrl>https://github.com/kellylford/rssquick</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
