<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package's manifest. A template: build/package-store.ps1 fills in each
  $TOKEN$ - identity from identity.json, the version from VERSION, the architecture per build -
  and writes the result into the package layout as AppxManifest.xml.

  A full-trust desktop app: the same RSSQuick.exe as every other build, run with the user's
  rights. runFullTrust is what allows that, and internetClient is what fetching feeds needs.
  docs/STORE-PLAN.md explains the rest.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="$NAME$"
    Publisher="$PUBLISHER$"
    Version="$VERSION$"
    ProcessorArchitecture="$ARCHITECTURE$" />

  <Properties>
    <DisplayName>RSS Quick</DisplayName>
    <PublisherDisplayName>$PUBLISHERDISPLAYNAME$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>An RSS reader built for screen reader and braille display users.</Description>
  </Properties>

  <!-- 1809, the oldest Windows 10 that .NET 10 supports. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="RSSQuick" Executable="RSSQuick.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="RSS Quick"
        Description="An RSS reader built for screen reader and braille display users."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
