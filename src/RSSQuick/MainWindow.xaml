<Window x:Class="RSSReaderWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RSSReaderWPF"
        Title="RSS Quick" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The menu bar: the same menus as the Mac's, in the same order, less the two that are
             the Mac's own (the application menu and Window). Alt or F10 reaches it; it is not in
             the tab ring, as a menu bar never is on Windows. Every item is a command the window
             already had, so each one calls the same method as its key and says in the status bar
             why it did nothing, rather than being greyed out - WPF skips a disabled menu item
             when arrowing, so a reader would never learn it was there.
             The access keys avoid D, B and U, which are Alt+D, Alt+B and Alt+U bindings. -->
        <Menu Grid.Row="0" Name="MainMenu" KeyboardNavigation.TabNavigation="None" IsTabStop="False">
            <MenuItem Header="_File">
                <MenuItem Header="_Import OPML File..." InputGestureText="Ctrl+O" Click="ImportOpml_Click"/>
                <MenuItem Header="_Export Feed List..." InputGestureText="Ctrl+E" Click="ExportFeedList_Click"/>
                <Separator/>
                <MenuItem Header="_Subscribe to Feed..." InputGestureText="Ctrl+N" Click="Subscribe_Click"/>
                <MenuItem Header="_Remove Feed" InputGestureText="Delete" Click="RemoveFeed_Click"/>
                <Separator/>
                <MenuItem Header="_Make This My Default Feed List" InputGestureText="Alt+D" Click="MakeDefault_Click"/>
                <MenuItem Header="Use S_tarter Feed List" Click="UseStarterList_Click"/>
                <Separator/>
                <MenuItem Header="Re_fresh" InputGestureText="F5" Click="Refresh_Click"/>
                <MenuItem Header="Sto_p Loading" InputGestureText="Esc" Click="StopLoading_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Search All Feeds..." InputGestureText="/ or Ctrl+F" Click="Search_Click"/>
            </MenuItem>
            <MenuItem Header="_Article">
                <MenuItem Header="_Open in Browser" InputGestureText="Alt+B" Click="OpenInBrowser_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Feed _Tree" InputGestureText="Ctrl+1" Click="FocusFeedTree_Click"/>
                <MenuItem Header="_Headlines" InputGestureText="Ctrl+2" Click="FocusHeadlines_Click"/>
                <MenuItem Header="_Next Pane" InputGestureText="F6" Click="NextPane_Click"/>
                <Separator/>
                <MenuItem Header="_Larger Text" InputGestureText="Ctrl+Plus" Click="LargerText_Click"/>
                <MenuItem Header="_Smaller Text" InputGestureText="Ctrl+Minus" Click="SmallerText_Click"/>
                <MenuItem Header="_Actual Size" InputGestureText="Ctrl+0" Click="ActualSize_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard Shortcuts" InputGestureText="F1" Click="KeyboardShortcuts_Click"/>
                <MenuItem Name="UpdateMenuItem" Header="_Check for Updates" Click="CheckForUpdates_Click"/>
                <Separator/>
                <MenuItem Name="AboutMenuItem" Header="_About RSS Quick" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Top Controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
            <Button Name="ImportOpmlButton" Content="Import OPML File (Ctrl+O)"
                    Click="ImportOpml_Click" Margin="0,0,10,0" Padding="10,5"
                    TabIndex="0"
                    AutomationProperties.AcceleratorKey="Ctrl+O"
                    ToolTip="Open a different OPML feed list (Ctrl+O)"/>
            <!-- Both start disabled; UpdateFeedListButtons enables them once there is something
                 for them to do. Disabled buttons leave the tab ring, which is why TabOrderTests
                 walks it with each state. -->
            <Button Name="MakeDefaultButton" Content="Make This My Default (Alt+D)"
                    Click="MakeDefault_Click" Margin="0,0,10,0" Padding="10,5"
                    TabIndex="1" IsEnabled="False"
                    AutomationProperties.AcceleratorKey="Alt+D"
                    AutomationProperties.HelpText="Open this feed list every time RSS Quick starts"
                    ToolTip="Open this feed list every time RSS Quick starts (Alt+D)"/>
            <Button Name="UseStarterListButton" Content="Use Starter Feed List"
                    Click="UseStarterList_Click" Margin="0,0,10,0" Padding="10,5"
                    TabIndex="2" IsEnabled="False"
                    AutomationProperties.HelpText="Forget your default feed list and go back to the one RSS Quick comes with"
                    ToolTip="Forget your default feed list and go back to the one RSS Quick comes with"/>
            <!-- Collapsed until App finds a newer version; ShowUpdate sets its text and shows it.
                 Collapsed rather than disabled, so it takes no room and no tab stop until then,
                 and a reader who never sees an update never meets it. -->
            <Button Name="UpdateButton" Click="Update_Click" Padding="10,5"
                    TabIndex="3" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Feed Tree -->
            <!-- IsTabStop="False" is load-bearing. Control defaults it to true, which made the
                 TreeView a tab stop in its own right, on top of the item inside it: Shift+Tab out
                 of a panel landed on the bare container, which reports no name, value or state,
                 and the GotFocus handler then pushed focus straight back in - so Shift+Tab looked
                 like it did nothing at all. TabNavigation="Once" collapses the items to a single
                 stop; with the container out of the tab order that stop is an item. The tree stays
                 Focusable so FeedTree.Focus() from F6 and the load path still works, and
                 FeedTree_GotFocus forwards that focus on to a node. -->
            <TreeView Grid.Column="0" Name="FeedTree"
                      SelectedItemChanged="FeedTree_SelectedItemChanged"
                      KeyDown="FeedTree_KeyDown"
                      PreviewKeyDown="FeedTree_PreviewKeyDown"
                      PreviewTextInput="FeedTree_PreviewTextInput"
                      GotFocus="FeedTree_GotFocus"
                      TabIndex="4"
                      IsTabStop="False"
                      KeyboardNavigation.TabNavigation="Once"
                      AutomationProperties.Name="RSS Feed Tree"
                      AutomationProperties.HelpText="Navigate with arrow keys, press Enter to load headlines">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <!-- A node is the tab stop, not the tree. Unlike ListBoxItem, TreeViewItem
                             is not one by default, so taking IsTabStop off the TreeView alone
                             dropped the whole panel out of the tab ring. -->
                        <Setter Property="IsTabStop" Value="True"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <!-- Folders are distinguished by weight alone. They used to be dark blue
                             as well, which is unreadable against the black background of a Windows
                             high contrast theme, and conveys nothing to a colour-blind user or a
                             screen reader in any theme. The tree structure already says which
                             nodes are folders. -->
                        <TextBlock Text="{Binding Title}"
                                  FontWeight="{Binding IsCategory, Converter={x:Static local:BoolToFontWeightConverter.Instance}}"/>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                          IsTabStop="False" Focusable="False"/>

            <!-- Headlines -->
            <Grid Grid.Column="2" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" Name="HeadlinesList"
                         ItemsSource="{Binding Headlines}"
                         SelectionChanged="HeadlinesList_SelectionChanged"
                         KeyDown="HeadlinesList_KeyDown"
                         TextSearch.TextPath="Title"
                         GotFocus="HeadlinesList_GotFocus"
                         Loaded="HeadlinesList_Loaded"
                         TabIndex="5"
                         IsTabStop="False"
                         KeyboardNavigation.TabNavigation="Once"
                         AutomationProperties.Name="Headlines List"
                         AutomationProperties.HelpText="Browse headlines with arrow keys, press Enter or Alt+B to open in browser">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                            <Setter Property="AutomationProperties.HelpText" Value="{Binding Published}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap"/>
                                <!-- GrayText rather than a literal grey: the system dims this
                                     colour in a normal theme and makes it fully legible in a high
                                     contrast one, where a fixed grey would be near-invisible. No
                                     FontSize, so the date follows the Windows text size like
                                     everything else rather than staying at 11pt. -->
                                <TextBlock Text="{Binding Published}"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Headline Controls -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                    <Button Name="OpenInBrowserButton" Content="Open in _Browser (Alt+B)"
                            Click="OpenInBrowser_Click" Padding="8,3"
                            TabIndex="6" IsEnabled="False"
                            ToolTip="Open the selected headline in your default web browser (Alt+B)"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Name="MainStatusBar"
                   Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                   Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
            <StatusBarItem>
                <TextBlock Name="StatusText" Text="{Binding StatusMessage}"
                          AutomationProperties.LiveSetting="Polite"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
