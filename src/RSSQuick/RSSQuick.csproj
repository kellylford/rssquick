<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>RSSQuick</AssemblyName>
    <RootNamespace>RSSReaderWPF</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- No RuntimeIdentifier or SelfContained here on purpose. Pinning them made a plain
         `dotnet build` produce a ~160 MB self-contained win-x64 tree, which is not what the
         dev loop wants and not what any of the publish scripts ask for: every one of them
         passes the runtime and self-contained switches explicitly. Both x64 and arm64
         publishes go through those scripts, so the RIDs live there. -->
    <PublishSingleFile>false</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Velopack has to run before WPF starts, so the entry point is Program.Main rather than
         the Main WPF generates for App.xaml - which is why App.xaml is compiled as a Page below. -->
    <StartupObject>RSSReaderWPF.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Syndication" Version="10.0.12" />
    <!-- Keep in step with vpk in .config/dotnet-tools.json: the packages vpk builds are read by
         this library, and Dependabot's velopack group moves the two together. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!-- So helpers that are internal because nothing outside the app should call them can still be
       tested directly, rather than being made public purely to be reachable. -->
  <ItemGroup>
    <InternalsVisibleTo Include="RSSQuick.Tests" />
  </ItemGroup>

  <!-- The sample feed list ships beside the executable so a Start Menu shortcut, whose working
       directory is not guaranteed, still finds a feed list on first run. -->
  <ItemGroup>
    <Content Include="RSS.opml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
